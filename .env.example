# ---------------------------------------------------------------------------
# Sereno · Variables de entorno
# Copia este archivo como .env para desarrollo local.
# Nunca subas .env a un repositorio.
# ---------------------------------------------------------------------------

# Puerto del servidor Express local (por defecto 3001).
PORT=3001

# Orígenes permitidos para la API, separados por comas.
# En local, Vite hace proxy de /api, así que puede quedar vacío.
# Para Capacitor, incluye el origen nativo si consumas la API desplegada:
#   CORS_ORIGINS=https://app.example.com,capacitor://localhost,http://localhost
CORS_ORIGINS=

# Máximo de solicitudes de contacto por IP cada 10 minutos (por defecto 5).
# Súbelo solo en entornos de prueba o QA; en producción mantén un límite bajo.
CONTACT_RATE_LIMIT_MAX=5

# --- Base de datos opcional (Supabase) -------------------------------------
# Crea un proyecto en https://supabase.com, ejecuta supabase/schema.sql en el
# SQL Editor y copia la URL y la service role key del proyecto.
# La service role key omite RLS: úsala SOLO en el servidor (Vercel env vars).
# Nunca la expongas en el cliente ni la prefijes con VITE_.
# Si estas variables están vacías, las solicitudes se guardan solo en memoria.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Notificaciones opcionales por correo (Resend) ------------------------
# Si no se configuran, la solicitud se registra pero no se envía correo.
# https://resend.com
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=equipo@example.com
CONTACT_FROM_EMAIL=Sereno <onboarding@resend.dev>

# --- Frontend --------------------------------------------------------------
# Vacío = mismo origen /api (web y Vercel).
# Para compilar la app móvil con Capacitor, apunta a la API desplegada:
#   VITE_API_BASE_URL=https://tu-proyecto.vercel.app
VITE_API_BASE_URL=
